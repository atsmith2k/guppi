{
  "name": "@atsmith2k/guppi",
  "version": "2.0.2",
  "description": "GUPPI — General-purpose Unifying Pluggable Intelligence & Agentic Sidecar",
  "main": "dist/server/index.js",
  "module": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "type": "module",
  "bin": {
    "guppi": "./bin/guppi.js"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:cli": "tsc",
    "build:ui": "vite build",
    "build": "npm run build:cli && npm run build:ui",
    "test": "node --import tsx --test --test-concurrency=1 test/poached_features.spec.ts test/agentic_assist.spec.ts test/lst_traversal.spec.ts",
    "prepublishOnly": "npm run build && npm test",
    "pack:check": "npm pack --dry-run",
    "start": "node bin/guppi.js start",
    "dev": "tsx src/cli/main.ts start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atsmith2k/guppi.git"
  },
  "bugs": {
    "url": "https://github.com/atsmith2k/guppi/issues"
  },
  "homepage": "https://github.com/atsmith2k/guppi#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agentic",
    "mcp",
    "rag",
    "sidecar",
    "memory",
    "onboarding",
    "telemetry",
    "model-context-protocol",
    "developer-tools",
    "codebase-indexing"
  ],
  "author": "GUPPI Development Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.2.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.0.0",
    "express": "^4.19.2",
    "glob": "^10.3.10",
    "ignore": "^5.3.1",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "tsx": "^4.10.5",
    "vite": "^5.2.11"
  }
}
